# Copy to .env and fill in. Never commit .env.

# Finnhub API key (free tier: https://finnhub.io/register)
FINNHUB_API_KEY=

# User-Agent required by SEC EDGAR fair-access policy, e.g. "Your Name you@example.com"
SEC_USER_AGENT=

# SQLite database file path (default: data/halal-stocks.db)
DATABASE_PATH=

# Port the API server listens on
PORT=3000