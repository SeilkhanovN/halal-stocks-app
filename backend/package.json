{
  "name": "backend",
  "version": "1.0.0",
  "description": "Node.js + TypeScript + Fastify API for halal-stocks.",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "seed:constituents": "tsx --env-file-if-exists=.env src/scripts/seed-constituents.ts",
    "seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "seed:fixtures": "tsx --env-file-if-exists=.env src/scripts/seed.ts --fixtures",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "fastify": "^5.12.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.5",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
